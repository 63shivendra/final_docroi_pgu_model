# Ensure all source code is always tracked
!src/**

# ==========================================
# HEAVY DATASETS & RAW FILES (>20GB)
# ==========================================
data/
*.mdb
*.lmdb
*.tar
*.zip
*.gz

# ==========================================
# LARGE MODEL WEIGHTS & CHECKPOINTS (>100MB)
# (GitHub rejects files >100MB)
# ==========================================
checkpoints/*.pth
checkpoints/*.pt
kaggle_trained_model/
*.pth
*.pt
*.bin
*.onnx

# ==========================================
# PYTHON & ENVIRONMENT ARTIFACTS
# ==========================================
